conky.config = {
    -- Window
    alignment          = '@ALIGNMENT@',
    gap_x              = 24,
    gap_y              = 60,
    minimum_width      = 300,
    maximum_width      = 300,
    minimum_height     = 0,

    -- Behavior
    background         = true,
    update_interval    = 2.0,
    double_buffer      = true,
    no_buffers         = true,
    cpu_avg_samples    = 2,
    net_avg_samples    = 2,

    -- Window style
    own_window         = true,
    own_window_type    = 'desktop',
    own_window_hints   = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value  = 220,
    own_window_colour  = '#0D1B3E',

    -- Border
    draw_borders       = false,
    draw_graph_borders = false,
    border_width       = 0,

    -- Font
    use_xft            = true,
    font               = 'JetBrains Mono:size=9',
    xftalpha           = 1,

    -- Colors
    default_color      = 'A0B4D6',
    color1             = '00D4FF',
    color2             = 'FF3D9A',
    color3             = '00E676',
    color4             = 'FFD600',
    color5             = 'C147E9',
    color6             = 'FFFFFF',

    stippled_borders   = 0,
    uppercase          = false,
    use_spacer         = 'none',
    short_units        = true,
    pad_percents       = 2,
}

conky.text = [[
${alignc}${color1}╭───────────╮
${alignc}${color1}│${color6} Dashboard ${color1}│
${alignc}${color1}╰───────────╯

${alignc}${color6}${time %A, %d %B %Y}
${alignc}${color default}${execi 3600 python3 -c "import datetime as d; n=d.datetime.now(); y=n.timetuple().tm_yday; print(f'Day {y} of 365')"}
${color1}${execbar 4 python3 -c "import datetime as d; n=d.datetime.now(); print(int(n.timetuple().tm_yday/365*100))"}

${color4}  UGANDA        ${color6}${tztime Africa/Kampala %H:%M:%S}
${color3}  UNITED STATES ${color6}${tztime America/New_York %H:%M:%S}
${color2}  INDIA         ${color6}${tztime Asia/Kolkata %H:%M:%S}
${color1}  DUBAI         ${color6}${tztime Asia/Dubai %H:%M:%S}
${color5}  CHINA         ${color6}${tztime Asia/Shanghai %H:%M:%S}

${color1}${hr 1}
@CPU_BLOCK@
${color4}  Temp: ${color6}${hwmon @TEMP_DEV@ temp 1}°C   ${color4}Load: ${color6}${loadavg}

${color2}${hr 1}
${color2}  RAM:   ${color6}${mem} / ${memmax}  ${color2}${memperc}%
${color2}${membar 4}
${color2}  Swap:  ${color6}${swap} / ${swapmax}  ${color2}${swapperc}%

${color5}${hr 1}
${color5}  Disk:  ${color6}${fs_used /} / ${fs_size /}  ${color5}${fs_used_perc /}%
${color5}${fs_bar 4 /}

${color1}${hr 1}
@NET_BLOCK@

${color4}${hr 1}
${color4}  Running: ${color6}${running_processes} / ${processes}
${color6}  ${top name 1}  ${color3}${top cpu 1}%
${color6}  ${top name 2}  ${color3}${top cpu 2}%
${color6}  ${top name 3}  ${color3}${top cpu 3}%
${color6}  ${top name 4}  ${color3}${top cpu 4}%
${color6}  ${top name 5}  ${color3}${top cpu 5}%
${color6}  ${top name 6}  ${color3}${top cpu 6}%
${color6}  ${top name 7}  ${color3}${top cpu 7}%
${color6}  ${top name 8}  ${color3}${top cpu 8}%
${color6}  ${top name 9}  ${color3}${top cpu 9}%
${color6}  ${top name 10}  ${color3}${top cpu 10}%

${color1}${hr 1}
${color6}  Uptime:  ${color1}${uptime}
${if_existing /sys/class/power_supply/@BATTERY@/status}${color6}  Battery: ${color3}${battery_percent @BATTERY@}%  ${color4}${battery_time @BATTERY@}  ${color6}${execi 10 cat /sys/class/power_supply/@BATTERY@/status}
${color3}${battery_bar 4 @BATTERY@}${endif}

${color1}${hr 1}
${alignc}${color1}[ BYTE OF THE DAY ]
${color6}${execi 3600 bash @FACT_SCRIPT@}

@FOOTER_BLOCK@
]]
